# Savoury Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# PostgreSQL connection (Supabase or self-hosted)
# connection_limit=1 forces every query in the app through ONE connection, so
# polling dashboards + check-ins queue behind each other and time out (P2024).
# The Supabase transaction pooler (port 6543) handles 5-10 per instance fine.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=5&pool_timeout=20"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Server port
PORT=3000

# JWT secret — generate a strong random string for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_48_CHARS"

# Website origin(s) allowed by CORS. Comma-separate several, e.g. a custom domain.
FRONTEND_URL=http://localhost:5173

# Only needed to create the very first Super Admin from the web Setup page.
# Leave unset in normal operation: setup is then disabled entirely.
# SETUP_TOKEN=
